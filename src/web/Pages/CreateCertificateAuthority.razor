@page "/ca/create"
@using Notary.Profiles
@using Notary.Validity

<MudContainer MaxWidth="MaxWidth.Large">
    @if (IsLoading)
    {
        <MudProgressLinear Indeterminate="true" Color="Color.Primary" Striped="true" Size="Size.Medium" />
    }
    <MudText Typo="Typo.h4">@PageTitle</MudText>
    <MudDivider Class="mb-3" />
    @if (_formErrors.Length > 0)
    {
        <MudItem xs="12" sm="5">
            <MudPaper Class="pa-4 mud-height-full">
                <MudText Typo="Typo.subtitle2">@($"Errors ({_formErrors.Length})")</MudText>
                @foreach (var error in _formErrors)
                {
                    <MudText Color="@Color.Error">
                        @error
                    </MudText>
                }
            </MudPaper>
        </MudItem>
        <MudDivider Class="mb-3" />
    }

    @if (_parentError != null)
    {
        <MudAlert Severity="Severity.Error" Class="my-2">
            @_parentError <MudLink Href="/ca">Back to certificate authorities</MudLink>
        </MudAlert>
    }
    else
    {
    <MudForm @ref="_mudForm" Model="ViewModel" @bind-IsValid="_formValid" @bind-Errors="_formErrors">
        @if (IsIntermediateMode && (ViewModel.SelectedCa ?? _parentCa) is { } issuingCa)
        {
            <MudText Typo="Typo.subtitle1" Class="mb-2">Issuing CA: @ParentLabel(issuingCa)</MudText>
        }
        @if (!IsRootMode && !IsIntermediateMode)
        {
        <MudSelect @bind-Value="@ViewModel.ParentCaSlug" Required="true"
            RequiredError="Select a parent CA or select No Parent" Label="Select Parent CA"
            HelperText="Select a Certificate Authority" Placeholder="Please Select">
            <MudSelectItem Value="@("nop")">No Parent</MudSelectItem>
            @foreach (var ca in ViewModel.CertificateAuthorities)
            {
                var canIssueCas = CaProfileCatalog.CheckCanIssueCas(ca).IsSuccess;
                <MudSelectItem Value="@ca.Slug" Disabled="@(!canIssueCas)">
                    @ParentLabel(ca)@(canIssueCas ? string.Empty : " - issues end-entity certificates only, not other CAs")
                </MudSelectItem>
            }
        </MudSelect>
        }
        @if (!IsRootMode)
        {
        <MudSelect T="CaPurpose?" @bind-Value="ViewModel.SelectedPurpose" @bind-Value:after="OnPurposeChanged"
            Label="CA Purpose" Required="true" RequiredError="Select what this CA is for"
            ToStringFunc="@(p => p.HasValue ? CaProfileCatalog.Get(p).DisplayName : string.Empty)"
            HelperText="One CA per purpose is the recommended practice" Placeholder="Please Select">
            @foreach (var option in PurposeOptions)
            {
                <MudSelectItem T="CaPurpose?" Value="@((CaPurpose?)option.Profile.Purpose)" Disabled="@(!option.IsAllowed)">
                    <b>@option.Profile.DisplayName</b>@(option.Profile.IsDiscouraged ? " (discouraged)" : string.Empty) - @option.Profile.Description@(option.IsAllowed ? string.Empty : $" [{option.DisabledReason}]")
                </MudSelectItem>
            }
        </MudSelect>
        }
        @if (SelectedProfile != null)
        {
            <MudAlert Severity="@(SelectedProfile.IsDiscouraged ? Severity.Warning : Severity.Info)" Class="my-2">
                @PurposeSummary
            </MudAlert>
        }
        @if (ViewModel.SelectedPurpose == CaPurpose.Custom)
        {
            <MudText Typo="Typo.body2" Class="my-2">
                Always included: @(string.Join(", ", AlwaysIncludedKeyUsages.Select(CaProfileCatalog.DescribeKeyUsage)))
            </MudText>
            <MudSelect T="CertificateKeyUsage" Label="Additional Key Usages" MultiSelection="true"
                @bind-SelectedValues="ViewModel.SelectedCustomKeyUsages"
                ToStringFunc="@(u => CaProfileCatalog.DescribeKeyUsage(u))"
                HelperText="Optional. Most CAs need none of these.">
                @foreach (var usage in OptionalKeyUsages)
                {
                    <MudSelectItem T="CertificateKeyUsage" Value="usage">@CaProfileCatalog.DescribeKeyUsage(usage)</MudSelectItem>
                }
            </MudSelect>
            <MudSelect T="string" Label="Extended Key Usages" MultiSelection="true"
                @bind-SelectedValues="ViewModel.SelectedCustomExtendedKeyUsages"
                Error="@CustomUsagesMissing" ErrorText="@CustomUsagesMissingText"
                HelperText="@CustomExtendedKeyUsageHelp">
                @foreach (var usage in KeyPurposeOids.Known)
                {
                    bool permitted = IsExtendedKeyUsagePermitted(usage.Key);
                    <MudSelectItem T="string" Value="usage.Key" Disabled="@(!permitted)">
                        @usage.Value@(permitted ? string.Empty : $" - not allowed by the {ParentPurposeName} CA")
                    </MudSelectItem>
                }
            </MudSelect>
        }
        <MudTextField @bind-Value="ViewModel.Name" Label="Name" Required="true"
            Validation="@(new Func<string, IEnumerable<string>>(ValidateName))"></MudTextField>
        <MudSelect T="ValidityPeriod" @bind-Value="ViewModel.SelectedPeriod" Label="CA Validity" Required="true"
            RequiredError="Select a validity period" ToStringFunc="@(p => p?.Format())"
            HelperText="@ValidityHelperText" Disabled="@(!AnyValidityAllowed)">
            @foreach (var option in ValidityOptions)
            {
                <MudSelectItem T="ValidityPeriod" Value="@option.Period" Disabled="@(!option.IsAllowed)">
                    @option.Label@(option.IsRecommended ? " (recommended)" : string.Empty)@(option.IsAllowed ? string.Empty : $" - {option.DisabledReason}")
                </MudSelectItem>
            }
        </MudSelect>
        <MudSwitch @bind-Value="ViewModel.IsIssuer" Label="Is Issuer"
            Disabled="@(ViewModel.SelectedPurpose == CaPurpose.Root)"></MudSwitch>
        @if (ViewModel.SelectedPurpose == CaPurpose.Root)
        {
            <MudText Typo="Typo.caption" Class="mb-2">A Root CA never issues certificates directly, so it is not offered as an issuer.</MudText>
        }
        @if (IsCrlHostLoopback)
        {
            <MudAlert Severity="Severity.Warning" Class="my-2">
                Certificates issued by the selected parent will point to a CRL at <b>@CrlBaseUrl</b>, which other
                machines cannot reach. Browse to this site by its public hostname or set NOTARY_CRL_ENDPOINT to its public address.
            </MudAlert>
        }
        <MudTextField @bind-Value="ViewModel.CommonName" Required="true" RequiredError="Please enter a CA Common Name"
            HelperText="The Common Name for the CA certificate (up to 64 characters)"
            Validation="@(new Func<string, IEnumerable<string>>(ValidateCommonName))"></MudTextField>
        <MudDivider Class="my-3" />
        <MudLink OnClick="@(() => ViewModel.AdditionalSubjectExpanded = !ViewModel.AdditionalSubjectExpanded)">
            Additional Properties</MudLink>
        <MudCollapse Expanded="ViewModel.AdditionalSubjectExpanded">
            <MudTextField @bind-Value="@ViewModel.Country" Label="Country" Disabled="ViewModel.SelectedCa!=null">
            </MudTextField>
            <MudTextField @bind-Value="@ViewModel.Locale" Label="Locale" Disabled="ViewModel.SelectedCa!=null">
            </MudTextField>
            <MudTextField @bind-Value="@ViewModel.Organization" Label="Organization"
                Disabled="ViewModel.SelectedCa!=null"></MudTextField>
            <MudTextField @bind-Value="@ViewModel.OrganizationalUnit" Label="Org Unit"
                Disabled="ViewModel.SelectedCa!=null"></MudTextField>
            <MudTextField @bind-Value="@ViewModel.StateProvince" Label="State" Disabled="ViewModel.SelectedCa!=null">
            </MudTextField>
        </MudCollapse>
        <MudDivider Class="my-3" />
        <MudLink OnClick="@(()=>ViewModel.KeyAlgorithmExpanded=!ViewModel.KeyAlgorithmExpanded)">Private Key Algorithm
        </MudLink>
        <MudCollapse Expanded="ViewModel.KeyAlgorithmExpanded">
            @if (ViewModel.SelectedCa != null)
            {
                <MudText Typo="Typo.subtitle2" Class="mt-2">@ParentKeyText</MudText>
                <MudAlert Severity="Severity.Info" Class="my-2">
                    Defaults to the parent CA's key. You can choose a different key type or size. @KeyFloorText
                </MudAlert>
            }
            <MudRadioGroup @bind-Value="@ViewModel.KeyType" T="Algorithm" @bind-Value:after="OnKeyTypeChanged">
                @if (RsaOffered)
                {
                    <MudRadio Value="@Algorithm.RSA">RSA</MudRadio>
                }
                @if (EllipticCurveOffered)
                {
                    <MudRadio Value="@Algorithm.EllipticCurve">Elliptic Curve</MudRadio>
                }
            </MudRadioGroup>
            <MudDivider />
            @if (ViewModel.KeyType == Algorithm.RSA)
            {
                <MudRadioGroup @bind-Value="@ViewModel.KeyLength" T="int">
                    @foreach (var length in AllowedRsaLengths)
                    {
                        <MudRadio Value="@length">
                            @RsaLabel(length)
                            @if (RsaRelation(length) is { } relation)
                            {
                                <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" Class="ml-2">@relation</MudChip>
                            }
                        </MudRadio>
                    }
                </MudRadioGroup>
            }
            else if (ViewModel.KeyType == Algorithm.EllipticCurve)
            {
                <MudRadioGroup @bind-Value="@ViewModel.Curve" T="EllipticCurve">
                    @foreach (var curve in AllowedCurves)
                    {
                        <MudRadio Value="@curve">
                            @CurveLabel(curve)
                            @if (CurveRelation(curve) is { } relation)
                            {
                                <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" Class="ml-2">@relation</MudChip>
                            }
                        </MudRadio>
                    }
                </MudRadioGroup>
            }
        </MudCollapse>
        <div class="d-flex align-center justify-space-between">
            <MudButton Variant="Variant.Filled" Color="Color.Primary" Class="ml-auto" OnClick="OnSubmitAsync">Submit
            </MudButton>
        </div>
    </MudForm>
    }
</MudContainer>