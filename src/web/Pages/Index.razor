@page "/"

<PageTitle>Change log</PageTitle>

<MudText Typo="Typo.h4" Class="mt-6 mb-4">Change log</MudText>

@if (LoadError != null)
{
    <MudAlert Severity="Severity.Warning">@LoadError</MudAlert>
}
else if (Entries.Count == 0)
{
    <MudAlert Severity="Severity.Info">There are no releases in the change log yet.</MudAlert>
}
else
{
    @foreach (var entry in Entries)
    {
        <MudPaper Class="pa-4 mb-4" Elevation="1">
            <MudStack Row="true" AlignItems="AlignItems.Baseline" Spacing="3" Class="mb-2">
                <MudText Typo="Typo.h5">@entry.Version</MudText>
                <MudText Typo="Typo.subtitle2" Color="Color.Secondary">@entry.Date.ToString("d MMMM yyyy")</MudText>
            </MudStack>
            <div class="changelog-notes">@Render(entry.Notes)</div>
        </MudPaper>
    }
}
