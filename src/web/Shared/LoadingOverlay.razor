<MudOverlay Visible="Visible" Modal="true" DarkBackground="true" ZIndex="1450">
    <MudPaper Elevation="8" Class="pa-6 d-flex flex-column align-center gap-3" role="status" aria-live="polite">
        <MudProgressCircular Color="Color.Primary" Size="Size.Large" Indeterminate="true" aria-hidden="true" />
        <MudText Typo="Typo.subtitle1">Loading…</MudText>
    </MudPaper>
</MudOverlay>

@code {
    /// <summary>
    /// True while the overlay should cover the viewport
    /// </summary>
    [Parameter]
    public bool Visible { get; set; }
}
