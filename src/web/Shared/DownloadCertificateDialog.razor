@using Notary.Download
<MudDialog>
    <TitleContent>
        <MudIcon Icon="fa-sharp fa-regular fa-download" Class="mr-3" />Download Certificate
    </TitleContent>
    <DialogContent>
        <MudForm Model="ViewModel" @ref="_form" @bind-IsValid="_isValid" @bind-Errors="_errors">
            <MudText Typo="Typo.body2">What do you want to download?</MudText>
            <MudRadioGroup Value="ViewModel.Format" ValueChanged="OnFormatChanged" T="CertificateFormat" Class="d-flex flex-column ml-4 mb-2">
                @foreach (var option in Options)
                {
                    <MudRadio Class="mud-width-full" Value="option.Format">@option.Label</MudRadio>
                }
            </MudRadioGroup>
            <MudAlert Severity="@(SelectedOption.ContainsPrivateKey ? Severity.Warning : Severity.Info)" Dense="true" Class="mb-3">
                @SelectedOption.Blurb
            </MudAlert>
            @if (IsCaCertificate)
            {
                <MudText Typo="Typo.caption" Class="mb-3">A certificate authority's private key never leaves Notary, so there is no private key bundle for it.</MudText>
            }
            <MudDivider Class="mb-2" />
            <MudTextField @bind-Value="ViewModel.FileName" Label="File name (optional)" MaxLength="100"
                HelperText="Leave blank to use the certificate name. The extension is added for you." />
            @if (SelectedOption.RequiresPassword)
            {
                <MudTextField @bind-Value="ViewModel.Password" Label="Password" InputType="InputType.Password"
                    Validation="@(new Func<string, IEnumerable<string>>(PasswordStrength))"
                    HelperText="Protects the private key in the file. You will need it to open the file." />
                <MudTextField @bind-Value="ViewModel.ConfirmPassword" InputType="InputType.Password"
                    Label="Confirm Password" Validation="@(new Func<string, string>(PasswordMatch))"
                    HelperText="Confirm Password" />
            }
        </MudForm>
    </DialogContent>
    <DialogActions>
        <MudButton Color="Color.Secondary" OnClick="OnCancel" Variant="Variant.Filled">Cancel</MudButton>
        <MudButton Color="Color.Primary" OnClick="OnOk" Variant="Variant.Filled">OK</MudButton>
    </DialogActions>
</MudDialog>
