# Copy to .env next to docker-compose.yml on the Pi and fill in. Keep it private: chmod 600 .env
# Never commit the real .env.

# Docker Hub account that owns the notary-web image
DOCKER_HUB_USER=

# Image tag to run. The Deploy workflow overrides this; leave as latest for manual `docker compose up -d`.
NOTARY_TAG=latest

# 16+ random characters. Back it up separately from the database. Do NOT change it once keys exist.
NOTARY_APP_KEY=

# MongoDB 5.0+ (Stable API v1). Not available on a Raspberry Pi 4 (see docs/ci-cd.md).
# Leave NOTARY_DB_HOST as is to use the bundled mongo service (docker compose --profile local-db up -d),
# or set it to your own server, e.g. mongodb://100.x.y.z:27017 (a host on your tailnet),
# or to MongoDB Atlas: mongodb+srv://cluster0.abcde.mongodb.net (host only; see docs/ci-cd.md).
# The username/password authenticate against the "admin" database. With the bundled mongo they become its root user
# on the first start of an empty volume; changing them later has no effect on existing data.
NOTARY_DB_HOST=mongodb://mongo:27017
NOTARY_DB_USERNAME=notary
NOTARY_DB_PASSWORD=
NOTARY_DB_NAME=notary

# Auth0 application (Regular Web App)
NOTARY_OPENID_DOMAIN=your-tenant.us.auth0.com
NOTARY_OPENID_CLIENTID=
NOTARY_OPENID_CLIENTSECRET=

# Optional public base URL for CRL distribution points. Use http:// (not https://): clients fetch CRLs
# unauthenticated and checking a site's revocation over its own TLS is circular. deploy/nginx/notary.conf
# serves /api/crl/ on port 80. Set it BEFORE issuing certificates; it is baked into each one.
# e.g. http://notary.unionsquared.lan
NOTARY_CRL_ENDPOINT=
